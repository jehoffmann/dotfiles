# Homebrew in PATH (Apple Silicon: /opt/homebrew, Intel: /usr/local)
# Installation von brew selbst macht install.sh, nicht die Shell.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

#ADDED BY 010 EDITOR
test -x "/Applications/010 Editor.app/Contents/CmdLine" && export PATH="$PATH:/Applications/010 Editor.app/Contents/CmdLine"

[[ -S "$HOME/Library/Group Containers/group.strongbox.mac.mcguill/agent.sock" ]] && \
  export SSH_AUTH_SOCK="$HOME/Library/Group Containers/group.strongbox.mac.mcguill/agent.sock"
