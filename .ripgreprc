# Ignore case unless the pattern contains uppercase letters
--smart-case

# Search hidden files (.github, .env.example, etc.)
--hidden

# Always exclude .git (needed because of --hidden)
--glob=!.git/

# Follow symlinks
--follow

# Truncate long lines instead of printing everything (e.g. minified files)
--max-columns=150
--max-columns-preview

# Skip build artefacts and generated files
--glob=!node_modules/
--glob=!target/
--glob=!dist/
--glob=!build/
--glob=!__pycache__/
--glob=!*.pyc
--glob=!*.o
--glob=!*.a
--glob=!*.so
--glob=!*.min.js
--glob=!*.min.css
