# bat configuration
# Theme: free Dracula (built in). With Dracula PRO, env.sh sets BAT_THEME="Dracula Pro",
# which takes precedence over this file (delta uses it too).
--theme="Dracula"

# Behave like cat — no pager, output streams directly
--paging=never

--italic-text=always

# Syntax hints for dotfiles bat doesn't recognise
--map-syntax ".aliases:Bourne Again Shell (bash)"
--map-syntax ".zshrc*:Bourne Again Shell (bash)"
--map-syntax ".bashrc*:Bourne Again Shell (bash)"
--map-syntax ".zshrc_*:Bourne Again Shell (bash)"
--map-syntax ".bashrc_*:Bourne Again Shell (bash)"
