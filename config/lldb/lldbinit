# lldb base settings. lldb has no XDG support – ~/.lldbinit is a symlink to this file.
# Also loaded by CLion/VS Code – therefore only harmless settings.
# Reverse engineering with lldbinit.py: alias `lldb-re` (see .aliases)

settings set target.x86-disassembly-flavor intel
settings set stop-disassembly-display no-debuginfo
settings set target.load-cwd-lldbinit false
