{
  "//": "Language servers come from PATH (mise/brew/apt) – coc downloads no binaries of its own",

  "go.goplsPath": "gopls",
  "go.checkForUpdates": "disabled",

  "rust-analyzer.server.path": "rust-analyzer",
  "rust-analyzer.updates.checkOnStartup": false,

  "clangd.path": "clangd",
  "clangd.checkUpdates": false,

  "languageserver": {
    "ruff": {
      "command": "ruff",
      "args": ["server"],
      "filetypes": ["python"]
    }
  },

  "[python]": { "coc.preferences.formatOnSave": true },
  "[go]":     { "coc.preferences.formatOnSave": true },
  "[rust]":   { "coc.preferences.formatOnSave": true }
}
