# gdb base settings (~/.config/gdb/gdbinit, gdb >= 11)
# Also loaded by CLion/VS Code – therefore only harmless settings.
# Reverse engineering with GEF: alias `gef` or `gef-multi` (see .aliases)

set history save on
set history size 10000
set history remove-duplicates unlimited
set history filename ~/.local/state/gdb/history

set print pretty on
set print object on
set pagination off
set confirm off
set disassembly-flavor intel
