# User information. Replace with your own data, obviously.
[include]
    path = ~/.gitconfig_user

[includeIf "gitdir:~/Developer/work/"]
    path = ~/Developer/work/.gitconfig

[init]
    defaultBranch = main

[branch]
    autosetupmerge = true
    autosetuprebase = always

[fetch]
    prune = true

[rerere]
    enabled = true

[pull]
    rebase = true

[push]
    default = current

[rebase]
    abbreviateCommands = true
    autoSquash = true
    autoStash = true

[core]
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    excludesfile = ~/.gitignore
    editor = vim
    pager = sh -c 'command -v delta >/dev/null 2>&1 && exec delta || exec less -FRX'

[delta]
    features = zebra-dark
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true

[alias]
    st = status
    ci = commit
    br = branch
    co = checkout
    conflicts = diff --name-only --diff-filter=U
    df = diff
    dc = diff --cached
    lol = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    ls = ls-files
    remotes = !git remote -v |awk '{ if (NR % 2 ==0)  print $1\" \" $2}'
    pushf = push --force-with-lease
    unstage = reset HEAD --
    resign = "!re() { git rebase --exec 'git commit --amend --no-edit -n -S' -i $1; }; re"
    css = commit --signoff --gpg-sign
    cso = commit --signoff
    cs = commit --gpg-sign
    dbc  = difftool -d --no-symlinks --tool=bc
    dbcf = difftool --tool=bc --prompt
    dvs  = difftool --tool=vscode --prompt
    mbc  = mergetool --tool=bc
    mvs  = mergetool --tool=vscode
    lols = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset %C(bold cyan)[%G?]%Creset' --abbrev-commit

[merge]
    summary = true
    conflictstyle = diff3

[diff]
    colorMoved = default

[mergetool]
    keepBackup = true

[difftool]
    prompt = false

[difftool "bc"]
	trustExitCode = true

[difftool "vscode"]
	cmd = code --wait --diff "$LOCAL" "$REMOTE"

[mergetool "bc"]
	trustExitCode = true

[mergetool "vscode"]
	cmd = code --wait "$MERGED"

[color]
	ui = auto

# if format is ssh we need a allowed_signers file see next section
# also set the user.signingkey to your pubkey. In case of gpg and a subkey
# set it like signingkey=<keyid>!
[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
