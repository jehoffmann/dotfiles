# Shared aliases — sourced by both bash and zsh

if command -v python3 >/dev/null 2>&1; then
  alias python='python3'
fi

# Debian/Ubuntu rename bat and fd
if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
  alias bat='batcat'
fi
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
  alias fd='fdfind'
fi

if command -v bat >/dev/null 2>&1 || command -v batcat >/dev/null 2>&1; then
  alias cat='bat'
  alias pat='bat --paging=always'
fi

if command -v eza >/dev/null 2>&1; then
  alias ls='eza'
  alias ll='eza -la --icons --git'
  alias la='eza -a --icons'
  alias lt='eza --tree --icons --level=2'
fi

if command -v btop >/dev/null 2>&1; then
  alias top='btop'
fi

if command -v lazygit >/dev/null 2>&1; then
  alias lg='lazygit'
fi

# Deliberately NOT overriding ps/find: different syntax breaks muscle memory
# and copy-pasted commands. Call procs/fd directly.

if command -v hexyl >/dev/null 2>&1; then
  alias hex='hexyl'
fi

# -a: scan all sections (not just loaded), -n 8: reduce noise vs default of 4
alias strings='strings -a -n 8'

if command -v nmap >/dev/null 2>&1; then
  alias nmap-ping='nmap -sn'               # host discovery, no port scan
  alias nmap-quick='nmap -T4 -F'           # fast scan, top 100 ports
  alias nmap-full='nmap -T4 -p- -sV'      # all 65535 ports + service detection
  alias nmap-udp='sudo nmap -sU --top-ports 50'  # UDP top 50 (SNMP, TFTP, …)
fi

if command -v jq >/dev/null 2>&1 && command -v fzf >/dev/null 2>&1; then
  # Interactive jq playground: jqrepl file.json  or  curl … | jqrepl
  jqrepl() {
    local tmp
    tmp=$(mktemp) || return
    command cat "${1:--}" >"$tmp"
    echo '' | fzf --disabled --query '.' \
      --print-query \
      --preview "jq -C {q} '$tmp' 2>&1" \
      --preview-window=up:90%
    rm -f "$tmp"
  }
fi

### Debugger ##################################################################
# Plain gdb/lldb stay clean (also in CLion/VS Code); RE extensions only via alias
if command -v gdb >/dev/null 2>&1; then
  alias gef='GEF_RC="${XDG_CONFIG_HOME:-$HOME/.config}/gef/gef.rc" gdb -q -ix "${XDG_DATA_HOME:-$HOME/.local/share}/gef/gef.py"'
fi
if command -v gdb-multiarch >/dev/null 2>&1; then
  alias gef-multi='GEF_RC="${XDG_CONFIG_HOME:-$HOME/.config}/gef/gef.rc" gdb-multiarch -q -ix "${XDG_DATA_HOME:-$HOME/.local/share}/gef/gef.py"'
fi
if command -v lldb >/dev/null 2>&1; then
  alias lldb-re='lldb -O "command script import ${XDG_CONFIG_HOME:-$HOME/.config}/lldb/lldbinit.py"'
fi

### SSH #######################################################################
alias ssh-pw='ssh -o PreferredAuthentications=password -o PasswordAuthentication=yes'
# Multiplexing — control running master connections
alias ssh-check='ssh -O check'      # ssh-check pm-coder → is the master alive?
alias ssh-exit='ssh -O exit'        # ssh-exit pm-coder  → close the master cleanly
alias ssh-stop='ssh -O stop'        # ssh-stop pm-coder  → no new connections, existing ones finish
alias ssh-mux='ls ~/.ssh/sockets/'  # list all active master sockets
alias ssh-killall='rm -f ~/.ssh/sockets/*'  # hard-kill all master sockets

# Agent
alias ssh-keys='ssh-add -l'         # which keys are loaded in the agent?
